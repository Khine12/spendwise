# Required: your OpenAI API key
OPENAI_API_KEY=sk-...
# Optional: model to use (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Required in production (Vercel): Postgres connection string from Neon
# Leave empty locally to use an embedded Postgres (PGlite) stored in ./.pglite
DATABASE_URL=
# Optional: timezone used to resolve "today", "yesterday", "last week"
APP_TIMEZONE=America/Los_Angeles
